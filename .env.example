# Credenciales de EmailJS (https://dashboard.emailjs.com)
# Copia este archivo como .env y completa los valores reales.
# El .env NO debe subirse nunca al repositorio.
#
# Importante: en una app de Vite todo lo que empieza con VITE_ queda
# incrustado en el JavaScript publico. Por eso, en el panel de EmailJS
# activa "Allowed origins" y deja solo tu dominio de Vercel, para que
# nadie mas pueda usar tu cuenta para enviar correos.

VITE_EMAILJS_SERVICE_ID=tu_service_id
VITE_EMAILJS_TEMPLATE_ID=tu_template_id
VITE_EMAILJS_PUBLIC_KEY=tu_public_key
